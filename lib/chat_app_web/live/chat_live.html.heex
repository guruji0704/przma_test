<div class="flex h-screen bg-gray-50">

  <%!-- SIDEBAR — Online Users --%>
  <div class="w-64 bg-white border-r border-gray-200 flex flex-col">

    <div class="p-4 border-b border-gray-200">
      <h2 class="font-bold text-gray-700 text-sm uppercase tracking-wide">
        Online Users
      </h2>
      <p class="text-xs text-gray-400 mt-1"><%= length(@users) %> online</p>
    </div>

    <div class="flex-1 overflow-y-auto p-3">
      <%= for user <- @users do %>
        <div
          class="flex items-center gap-2 py-2 px-2 rounded-lg
                 hover:bg-blue-50 cursor-pointer group"
          phx-click="select_mention"
          phx-value-username={user}
          title={"Click to @mention #{user}"}
        >
          <div class="w-2 h-2 rounded-full bg-green-400 flex-shrink-0"></div>
          <span class={[
            "text-sm truncate flex-1",
            if(user == @username,
              do: "font-bold text-blue-600",
              else: "text-gray-700 group-hover:text-blue-500")
          ]}>
            <%= if user == @username, do: "#{user} (you)", else: user %>
          </span>
          <%!-- @ icon appears on hover --%>
          <%= if user != @username do %>
            <span class="text-xs text-blue-400 opacity-0 group-hover:opacity-100">
              @
            </span>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="p-4 border-t border-gray-200 bg-gray-50">
      <p class="text-xs text-gray-400">You are</p>
      <p class="text-sm font-semibold text-blue-600 truncate"><%= @username %></p>
    </div>
  </div>

  <%!-- MAIN CHAT --%>
  <div class="flex-1 flex flex-col min-w-0">

    <%!-- Header --%>
    <div class="bg-white border-b border-gray-200 p-4 flex items-center gap-3">
      <div class="w-3 h-3 rounded-full bg-green-400"></div>
      <div>
        <h1 class="font-bold text-gray-800"># <%= @room %></h1>
        <p class="text-xs text-gray-400">
          <%= length(@messages) %> messages ·
          <%= length(@users) %> online ·
          type @ to mention
        </p>
      </div>
    </div>

    <%!-- Flash --%>
    <%= if @flash["error"] do %>
      <div class="bg-red-100 text-red-600 p-3 text-sm text-center">
        <%= @flash["error"] %>
      </div>
    <% end %>

    <%!-- Messages --%>
    <div
      id="messages"
      phx-hook="ScrollBottom"
      class="flex-1 overflow-y-auto p-4 space-y-4"
    >
      <%= if @messages == [] do %>
        <div class="text-center text-gray-400 mt-20">
          <p class="text-5xl mb-3">💬</p>
          <p class="font-medium text-lg">No messages yet</p>
          <p class="text-sm">Be the first to say hello!</p>
        </div>
      <% end %>

      <%= for msg <- @messages do %>
        <div class={[
          "flex gap-3 items-end",
          if(msg.username == @username, do: "flex-row-reverse", else: "flex-row")
        ]}>

          <div class="w-8 h-8 rounded-full bg-blue-500
                      flex items-center justify-center flex-shrink-0">
            <span class="text-white text-xs font-bold">
              <%= String.first(msg.username) |> String.upcase() %>
            </span>
          </div>

          <div class={[
            "flex flex-col max-w-xs lg:max-w-md",
            if(msg.username == @username, do: "items-end", else: "items-start")
          ]}>

            <div class={[
              "flex items-center gap-2 mb-1",
              if(msg.username == @username, do: "flex-row-reverse", else: "flex-row")
            ]}>
              <span class="text-xs font-semibold text-gray-600">
                <%= if msg.username == @username, do: "You", else: msg.username %>
              </span>
              <span class="text-xs text-gray-400">
                <%= format_time(msg.inserted_at) %>
              </span>
              <%= if @username in (msg.mentions || []) do %>
                <span class="text-xs bg-yellow-100 text-yellow-700
                             px-2 py-0.5 rounded-full font-medium animate-pulse">
                  @ you
                </span>
              <% end %>
            </div>

            <div class={[
              "rounded-2xl px-4 py-2 text-sm break-words shadow-sm",
              if(msg.username == @username,
                do: "bg-blue-500 text-white rounded-tr-none",
                else: "bg-white border border-gray-200 text-gray-800 rounded-tl-none"
              )
            ]}>
              <%= raw(highlight_mentions(msg.body, @username)) %>
            </div>

          </div>
        </div>
      <% end %>
    </div>

    <%!-- Input Area --%>
    <div class="bg-white border-t border-gray-200 p-4">

      <%!-- @MENTION DROPDOWN — shows above input when typing @ --%>
      <%= if @show_mentions and @filtered_users != [] do %>
        <div class="mb-2 bg-white border border-gray-200 rounded-xl
                    shadow-lg overflow-hidden max-h-48 overflow-y-auto">

          <div class="px-3 py-2 bg-gray-50 border-b border-gray-100">
            <p class="text-xs text-gray-500 font-medium">
              👥 Select a user to mention
              <%= if @mention_query != "" do %>
                <span class="text-blue-500">— filtering "@<%= @mention_query %>"</span>
              <% end %>
            </p>
          </div>

          <%= for user <- @filtered_users do %>
            <button
              type="button"
              phx-click="select_mention"
              phx-value-username={user}
              class="w-full flex items-center gap-3 px-4 py-2.5
                     hover:bg-blue-50 text-left transition-colors"
            >
              <%!-- Avatar --%>
              <div class="w-7 h-7 rounded-full bg-blue-500
                          flex items-center justify-center flex-shrink-0">
                <span class="text-white text-xs font-bold">
                  <%= String.first(user) |> String.upcase() %>
                </span>
              </div>
              <%!-- Username --%>
              <div>
                <p class="text-sm font-medium text-gray-800">@<%= user %></p>
              </div>
              <%!-- Green dot --%>
              <div class="ml-auto w-2 h-2 rounded-full bg-green-400"></div>
            </button>
          <% end %>

        </div>
      <% end %>

      <%!-- Show "no match" if @ typed but nobody matches --%>
      <%= if @show_mentions and @filtered_users == [] and @mention_query != "" do %>
        <div class="mb-2 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3">
          <p class="text-xs text-gray-400">
            No user found matching "@<%= @mention_query %>"
          </p>
        </div>
      <% end %>

      <%!-- Hint text --%>
      <p class="text-xs text-gray-400 mb-2">
        💡 Type <span class="font-mono bg-gray-100 px-1 rounded">@</span>
        to mention · click a name in sidebar to @mention
      </p>

      <form phx-submit="send" phx-change="update_message" class="flex gap-3">
        <input
          id="message-input"
          name="message"
          value={@message}
          placeholder={"Message ##{@room}... (type @ to mention)"}
          autocomplete="off"
          phx-key="Escape"
          phx-keydown="dismiss_mentions"
          class="flex-1 border border-gray-300 rounded-xl px-4 py-2
                 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
        <button
          type="submit"
          disabled={String.trim(@message) == ""}
          class="bg-blue-500 hover:bg-blue-600 disabled:bg-gray-300
                 disabled:cursor-not-allowed text-white px-6 py-2
                 rounded-xl text-sm font-semibold transition"
        >
          Send
        </button>
      </form>
    </div>

  </div>
</div>